{
  "manifest_version": 3,
  "name": "Keepit - Translate & Highlight Notes",
  "version": "3.4.575",
  "description": "Highlight text, add notes, and organize a local library in English, Vietnamese, or Korean.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "browser-polyfill.js",
      "messaging.js",
      "error-logger.js",
      "config.js",
      "settings.js",
      "cache.js",
      "translate.js",
      "usage-limits.js",
      "annotations.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "browser-polyfill.js",
        "messaging.js",
        "error-logger.js",
        "custom-font.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-polyfill.js",
        "messaging.js",
        "config.js",
        "settings.js",
        "languages.js",
        "web-highlighter.js",
        "study-translation.js",
        "dictionary.js",
        "search.js",
        "tts-engine.js",
        "sentence-note.js",
        "ui-components.js",
        "page-layout.js",
        "content.js",
        "lib/Readability.js",
        "lib/Readability-readerable.js",
        "bilingual-flags.js",
        "bilingual-reader.js"
      ],
      "css": [
        "ui-tokens.css",
        "content.css",
        "content-theme.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-highlight-notes@example.local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://lingva.thedaviddelta.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_title": "Keepit - Highlight Notes",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "16": "icons/icon-16.png"
    }
  }
}
