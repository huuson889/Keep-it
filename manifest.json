{
  "manifest_version": 3,
  "name": "Keepit - Translate & Highlight Notes",
  "version": "3.5.79",
  "description": "Highlight text, add notes, and organize a local library in English, Vietnamese, or Korean.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "declarativeNetRequest",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel"
  ],
  "background": {
    "service_worker": "js/background/background.js",
    "scripts": [
      "js/core/browser-polyfill.js",
      "js/core/messaging.js",
      "js/core/error-logger.js",
      "js/core/defaults.js",
      "js/core/config.js",
      "js/core/settings.js",
      "js/core/cache.js",
      "js/translate/translate.js",
      "js/background/usage-limits.js",
      "js/background/annotations.js",
      "js/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/core/error-logger.js",
        "js/shared/custom-font.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/core/defaults.js",
        "js/core/config.js",
        "js/core/settings.js",
        "js/core/languages.js",
        "js/content/web-highlighter.js",
        "js/translate/study-translation.js",
        "js/translate/dictionary.js",
        "js/translate/search.js",
        "js/reader/tts-engine.js",
        "js/content/sentence-note.js",
        "js/content/ui-components.js",
        "js/content/page-layout.js",
        "js/core/shortcuts.js",
        "js/content/sidebar.js",
        "js/content/note-composer.js",
        "js/content/annotation-restore.js",
        "js/shared/thumbnails.js",
        "js/shared/site-icons.js",
        "js/content/chatgpt-context.js",
        "js/content/content.js",
        "vendor/readability/Readability.js",
        "vendor/readability/Readability-readerable.js",
        "js/shared/search.js",
        "js/reader/bilingual-flags.js",
        "js/reader/bilingual-reader.js",
        "js/overlay/overlay-template.js",
        "js/overlay/source/video.js",
        "js/overlay/source/web.js",
        "js/overlay/view/layout-mode.js",
        "js/overlay/view/cc-mode.js",
        "js/overlay/study/shared/study-score.js",
        "js/overlay/study/shared/learning-rules.js",
        "js/overlay/study/shared/session-index.js",
        "js/overlay/study/shadowing/shadowing-activity.js",
        "js/overlay/study/dictation/dictation.js",
        "js/overlay/study/shadowing/shadowing.js",
        "js/overlay/overlay-controller.js"
      ],
      "css": [
        "css/shared/ui-tokens.css",
        "css/content/content.css",
        "css/content/content-theme.css",
        "css/content/video.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "js/content/chatgpt-link-marker.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/content/chatgpt-autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-highlight-notes@example.local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon.svg",
        "assets/fonts/TwemojiCountryFlags.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://lingva.thedaviddelta.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_title": "Keepit - Highlight Notes",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "32": "assets/icons/icon-32.png",
      "16": "assets/icons/icon-16.png"
    }
  },
  "sidebar_action": {
    "default_title": "ChatGPT",
    "default_panel": "pages/chatgpt-firefox-sidebar.html",
    "open_at_install": false
  },
  "side_panel": {
    "default_path": "pages/chatgpt-chrome-sidepanel.html"
  },
  "commands": {
    "open-chatgpt-sidepanel": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Toggle ChatGPT panel and prepare an unsent page draft"
    }
  }
}
