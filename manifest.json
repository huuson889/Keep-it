{
  "manifest_version": 2,
  "name": "Keepit - Translate & Highlight Notes",
  "version": "3.4.501",
  "description": "Highlight text, add notes, and organize a local library in English, Vietnamese, or Korean.",
  "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http:;",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "<all_urls>",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://lingva.thedaviddelta.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "browser_action": {
    "default_title": "Keepit - Highlight Notes",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon.svg",
      "16": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "config.js",
      "usage-limits.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "custom-font.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "i18n.js",
        "web-highlighter.js",
        "study-translation.js",
        "content.js",
        "bilingual-reader.js"
      ],
      "css": [
        "ui-tokens.css",
        "content.css",
        "content-theme.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-highlight-notes@example.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "96": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "web_accessible_resources": [
    "icons/icon.svg"
  ]
}
