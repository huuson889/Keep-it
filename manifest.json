{
  "manifest_version": 3,
  "name": "Keepit - Translate, Learn, Ask AI",
  "version": "3.5.146",
  "description": "Translate web pages bilingually. Highlights, notes, dictionary, video player, Ask AI, speaking and listening practice, flashcards.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "declarativeNetRequest",
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "js/background/background.js",
    "scripts": [
      "js/core/browser-polyfill.js",
      "js/core/messaging.js",
      "js/core/error-logger.js",
      "js/core/defaults.js",
      "js/core/config.js",
      "js/core/settings.js",
      "js/core/cache.js",
      "js/translate/translate.js",
      "js/background/usage-limits.js",
      "js/background/annotations.js",
      "js/ask-ai/providers.js",
      "js/ask-ai/prompt-format.js",
      "js/ask-ai/service.js",
      "js/shared/selection-toolbar.js",
      "js/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/core/error-logger.js",
        "js/shared/custom-font.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/core/defaults.js",
        "js/core/config.js",
        "js/core/settings.js",
        "js/core/languages.js",
        "js/content/web-highlighter.js",
        "js/translate/study-translation.js",
        "js/translate/dictionary.js",
        "js/translate/search.js",
        "js/reader/tts-engine.js",
        "js/content/sentence-note.js",
        "js/content/ui-components.js",
        "js/content/page-layout.js",
        "js/core/shortcuts.js",
        "js/content/sidebar.js",
        "js/content/note-composer.js",
        "js/content/annotation-restore.js",
        "js/shared/thumbnails.js",
        "js/shared/site-icons.js",
        "js/shared/selection-toolbar.js",
        "js/content/content.js",
        "vendor/readability/Readability.js",
        "vendor/readability/Readability-readerable.js",
        "js/shared/search.js",
        "js/reader/bilingual-flags.js",
        "js/reader/bilingual-reader.js",
        "js/overlay/overlay-template.js",
        "js/overlay/source/video.js",
        "js/overlay/source/web.js",
        "js/overlay/view/layout-mode.js",
        "js/overlay/view/cc-mode.js",
        "js/overlay/study/shared/study-score.js",
        "js/overlay/study/shared/learning-rules.js",
        "js/overlay/study/shared/session-index.js",
        "js/overlay/study/shadowing/shadowing-activity.js",
        "js/overlay/study/dictation/dictation.js",
        "js/overlay/study/shadowing/shadowing.js",
        "js/overlay/overlay-controller.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "css": [
        "css/shared/ui-tokens.css",
        "css/shared/selection-toolbar.css",
        "css/content/content.css",
        "css/content/content-theme.css",
        "css/content/video.css"
      ]
    },
    {
      "matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/ask-ai/providers.js",
        "js/ask-ai/page/grok-google-auth.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "js/ask-ai/page/chatgpt-link-marker.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "js/core/browser-polyfill.js",
        "js/core/messaging.js",
        "js/ask-ai/providers.js",
        "js/ask-ai/prompt-format.js",
        "js/ask-ai/page/composer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "js/ask-ai/page/send-flow.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d3706e53-29aa-4415-b396-c60e6903ec09}",
      "strict_min_version": "147.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      }
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon.svg",
        "assets/fonts/TwemojiCountryFlags.woff2",
        "assets/images/web-thumbnail-lofi.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://lingva.ml/*",
    "https://lingva.thedaviddelta.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_title": "Keepit - Translate, Learn, Ask AI",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "32": "assets/icons/icon-32.png",
      "16": "assets/icons/icon-16.png"
    }
  },
  "sidebar_action": {
    "default_title": "Keepit - Translate, Learn, Ask AI",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    },
    "default_panel": "pages/ai-panel.html",
    "open_at_install": false
  },
  "side_panel": {
    "default_path": "pages/ai-panel.html"
  },
  "commands": {
    "open-chatgpt-sidepanel": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Toggle the AI panel and add context from the current page"
    }
  }
}
